<canvas id="particleCanvas" class="particle-canvas desktop-only" aria-hidden="true"></canvas>
<div class="mobile-background mobile-only" aria-hidden="true"></div>

<style>
  .particle-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 2;
    opacity: 0.8;
    mix-blend-mode: screen;
    background: transparent;
    overflow: hidden;
    transform: translateZ(0);
    will-change: transform;
  }

  .mobile-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 2;
    background: radial-gradient(circle at 50% 50%,
      rgba(46, 160, 67, 0.1) 0%,
      rgba(88, 166, 255, 0.1) 100%
    );
  }

  .desktop-only {
    display: none;
  }

  .mobile-only {
    display: block;
  }

  @media (min-width: 769px) {
    .desktop-only {
      display: block;
    }
    .mobile-only {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .particle-canvas,
    .mobile-background {
      display: none !important;
    }
  }
</style>

<script>
function shouldReduceMotion() {
  return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
}

class Particle {
  constructor(x, y) {
    this.x = x;
    this.y = y;
    this.size = Math.random() * 1 + 0.5;
    this.baseSize = this.size;
    this.speedX = Math.random() * 0.8 - 0.4;
    this.speedY = Math.random() * 0.8 - 0.4;
    this.color = ['#2ea043', '#58a6ff'][Math.floor(Math.random() * 2)];
    this.alpha = Math.random() * 0.1 + 0.05;
    this.baseAlpha = this.alpha;
    this.friction = 0.98;
    this.gravity = 0.005;
    this.pulseSpeed = 0.05 + Math.random() * 0.05;
    this.pulseOffset = Math.random() * Math.PI * 2;
  }

  update(mouseX, mouseY, time) {
    this.x += this.speedX;
    this.y += this.speedY;

    this.speedX *= this.friction;
    this.speedY *= this.friction;

    const pulse = Math.sin(time * this.pulseSpeed + this.pulseOffset);
    this.size = this.baseSize + pulse * 0.5;
    this.alpha = this.baseAlpha + pulse * 0.1;

    if (mouseX != null && mouseY != null) {
      const dx = mouseX - this.x;
      const dy = mouseY - this.y;
      const distance = Math.sqrt(dx * dx + dy * dy);

      if (distance < 300) {
        const influence = 1 - distance / 300;
        this.speedX += (dx / distance) * this.gravity * influence * 1.5;
        this.speedY += (dy / distance) * this.gravity * influence * 1.5;
        this.size = this.baseSize + influence * 3;
        this.alpha = this.baseAlpha + influence * 0.3;
      }
    }

    const margin = 50;
    if (this.x < margin) {
      this.speedX += (margin - this.x) * 0.02;
    } else if (this.x > innerWidth - margin) {
      this.speedX -= (this.x - (innerWidth - margin)) * 0.02;
    }
    if (this.y < margin) {
      this.speedY += (margin - this.y) * 0.02;
    } else if (this.y > innerHeight - margin) {
      this.speedY -= (this.y - (innerHeight - margin)) * 0.02;
    }

    const maxSpeed = 1.5;
    const currentSpeed = Math.sqrt(this.speedX ** 2 + this.speedY ** 2);
    if (currentSpeed > maxSpeed) {
      this.speedX = (this.speedX / currentSpeed) * maxSpeed;
      this.speedY = (this.speedY / currentSpeed) * maxSpeed;
    }
  }

  draw(ctx) {
    ctx.beginPath();
    ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
    ctx.fillStyle = this.color;
    ctx.globalAlpha = this.alpha;
    ctx.shadowBlur = this.size * 5;
    ctx.shadowColor = this.color;
    ctx.fill();
  }
}

class ParticleSystem {
  constructor() {
    this.canvas = document.getElementById('particleCanvas');
    this.ctx = this.canvas.getContext('2d');
    this.particles = [];
    this.mouseX = null;
    this.mouseY = null;
    this.lastTime = 0;
    this.prevWidth = innerWidth;
    this.prevHeight = innerHeight;
    this.init();
  }

  init() {
    this.resize();
    window.addEventListener('resize', () => this.resize());
    document.addEventListener('mousemove', (e) => {
      this.mouseX = e.clientX;
      this.mouseY = e.clientY;
    }, { passive: true });
    this.createParticles();
    requestAnimationFrame((t) => this.animate(t));
  }

  resize() {
    const dpr = devicePixelRatio || 1;
    this.canvas.width = innerWidth * dpr;
    this.canvas.height = innerHeight * dpr;
    this.canvas.style.width = `${innerWidth}px`;
    this.canvas.style.height = `${innerHeight}px`;
    this.ctx.scale(dpr, dpr);

    if (this.particles.length > 0) {
      const sx = innerWidth / this.prevWidth;
      const sy = innerHeight / this.prevHeight;
      for (const p of this.particles) {
        p.x *= sx;
        p.y *= sy;
      }
    } else {
      this.createParticles();
    }

    this.prevWidth = innerWidth;
    this.prevHeight = innerHeight;
  }

  createParticles() {
    const count = Math.min((innerWidth * innerHeight) / 40000, 80);
    for (let i = 0; i < count; i++) {
      this.particles.push(new Particle(
        Math.random() * innerWidth,
        Math.random() * innerHeight
      ));
    }
  }

  animate(timestamp) {
    if (timestamp - this.lastTime < 160) {
      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
      for (const p of this.particles) {
        p.update(this.mouseX, this.mouseY, timestamp * 0.001);
        p.draw(this.ctx);
      }
    }
    this.lastTime = timestamp;
    requestAnimationFrame((t) => this.animate(t));
  }
}

function init() {
  if (shouldReduceMotion() || innerWidth <= 768) return;

  const canvas = document.getElementById('particleCanvas');
  if (canvas) {
    new ParticleSystem();
  } else {
    let attempts = 0;
    const retry = setInterval(() => {
      const el = document.getElementById('particleCanvas');
      if (el) {
        clearInterval(retry);
        new ParticleSystem();
      } else if (++attempts >= 10) {
        clearInterval(retry);
      }
    }, 100);
  }
}

if (document.readyState === 'complete' || document.readyState === 'interactive') {
  init();
} else {
  document.addEventListener('DOMContentLoaded', init);
}
</script>
