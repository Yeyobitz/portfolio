---
import type { Skill } from '../../types/cv';
import SkillBadge from './SkillBadge.astro';

interface Props {
  category: string;
  skills: Skill[];
}

const { category, skills } = Astro.props;
---

<div class="category">
  <h3 class="category-title">{category}</h3>
  <div class="skills-grid">
    {skills.map(skill => (
      <SkillBadge name={skill.name} level={skill.level} />
    ))}
  </div>
</div>

<style>
  .category {
    margin-bottom: 2rem;
  }

  .category-title {
    border-left: 4px solid var(--color-accent);
    padding-left: 0.75rem;
    margin-bottom: 1rem;
    font-size: 1.1rem;
    color: var(--color-text-primary);
  }

  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-left: 1.75rem;
  }
</style>
