---
import type { Skill } from '../../types/cv';
import SkillCategory from './SkillCategory.astro';
import TerminalHeader from '../TerminalHeader.astro';
import SkillOrbit from './SkillOrbit.astro';

interface Props {
  skills: Skill[];
}

const { skills } = Astro.props;

// Group skills by primary keyword (category)
const groupedSkills = skills.reduce((acc, skill) => {
  const category = skill.keywords[0];
  if (!acc[category]) {
    acc[category] = [];
  }
  acc[category].push(skill);
  return acc;
}, {} as Record<string, Skill[]>);

// Sort categories by importance
const categoryOrder = [
  "Web development",
  "Databases",
  "Version control",
  "Game Development",
  "Design",
  "Development Tools"
];

const sortedCategories = Object.entries(groupedSkills).sort(([a], [b]) => {
  return categoryOrder.indexOf(a) - categoryOrder.indexOf(b);
});
---

<section class="skills-section crt" id="skills">
  <TerminalHeader title="SKILL_TREE" num="03" xp={25} tag={`${skills.length} NODES`} />
  <div class="terminal-content">
    <p class="skills-intro">
      Hover a node to inspect it, drag to rotate the tree. Node size is how much I trust
      myself with it, not how much I like it.
    </p>

    <SkillOrbit skills={skills} />

    {sortedCategories.map(([category, categorySkills]) => (
      <SkillCategory category={category} skills={categorySkills} />
    ))}
  </div>
</section>

<style>
  .skills-section {
    position: relative;
    margin: 0 auto 2.5rem;
    background: linear-gradient(180deg, rgba(7, 12, 18, 0.82), rgba(5, 9, 14, 0.9));
    border: 1px solid rgba(0, 240, 255, 0.2);
    border-radius: 4px;
    overflow: hidden;
    backdrop-filter: blur(8px);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.45);
  }

  .skills-intro {
    margin: 0 0 0.5rem;
    font-size: 0.86rem;
    line-height: 1.75;
    color: rgba(190, 212, 225, 0.72);
    max-width: 62ch;
  }

  .terminal-content {
    padding: 2rem;
  }

  @media (max-width: 768px) {
    .terminal-content {
      padding: 1rem;
    }
  }
</style>