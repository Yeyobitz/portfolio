---
import type { Skill } from '../../types/cv';
import SkillBadge from './SkillBadge.astro';

interface Props {
  skills: Skill[];
}

const { skills } = Astro.props;

const groupedSkills = skills.reduce((acc, skill) => {
  const category = skill.category || skill.keywords[0];
  if (!acc.has(category)) acc.set(category, []);
  acc.get(category)!.push(skill);
  return acc;
}, new Map<string, Skill[]>());

const categories = [...groupedSkills.entries()];
---

<section id="skills">
  <div class="container">
    <h2>Skills</h2>
    {categories.map(([category, categorySkills]) => (
      <div class="category">
        <h3 class="category-title">{category}</h3>
        <div class="skills-grid">
          {categorySkills.map(skill => (
            <SkillBadge name={skill.name} level={skill.level} />
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  #skills {
    padding: var(--space-2xl) 0;
  }

  .container {
    max-width: var(--container-width);
  }

  h2 {
    border-left: 4px solid #2ea043;
    padding-left: 1rem;
    margin-bottom: 2rem;
  }

  .category {
    margin-bottom: 2rem;
  }

  .category-title {
    border-left: 4px solid var(--color-accent);
    padding-left: 0.75rem;
    margin-bottom: 1rem;
    font-size: 1.1rem;
    color: var(--color-text-primary);
  }

  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-left: 1.75rem;
  }
</style>
