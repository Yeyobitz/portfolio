---
interface Props {
  caseStudy: {
    process?: {
      planning?: string;
      challenges?: string[];
      solutions?: string[];
      learnings?: string[];
    };
    timeline?: { date: string; milestone: string }[];
  };
}

const { caseStudy } = Astro.props;
const { process, timeline } = caseStudy;
---

<div class="case-study">
  <button class="toggle" type="button" aria-expanded="false">
    <span class="toggle-icon">+</span>
    Ver más
  </button>
  <div class="content" hidden>
    {process && (
      <div class="process-section">
        {process.planning && (
          <div class="block">
            <h4>Planificación</h4>
            <p>{process.planning}</p>
          </div>
        )}

        {process.challenges && process.challenges.length > 0 && (
          <div class="block">
            <h4>Desafíos</h4>
            <ul>
              {process.challenges.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )}

        {process.solutions && process.solutions.length > 0 && (
          <div class="block">
            <h4>Soluciones</h4>
            <ul>
              {process.solutions.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )}

        {process.learnings && process.learnings.length > 0 && (
          <div class="block">
            <h4>Aprendizajes</h4>
            <ul>
              {process.learnings.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}

    {timeline && timeline.length > 0 && (
      <div class="block">
        <h4>Línea de tiempo</h4>
        <div class="timeline">
          {timeline.map((entry) => (
            <div class="timeline-entry">
              <span class="timeline-date">{entry.date}</span>
              <span class="timeline-milestone">{entry.milestone}</span>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</div>

<style>
  .case-study {
    margin-top: 1rem;
    padding: 1rem;
    background: var(--color-bg-tertiary);
    border-radius: 6px;
  }

  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    font-family: var(--font-heading);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }

  .toggle:hover {
    border-color: var(--color-border-highlight);
    color: var(--color-text-primary);
  }

  .toggle-icon {
    display: inline-block;
    width: 1em;
    text-align: center;
    font-size: 1rem;
  }

  .content {
    margin-top: 1rem;
  }

  .content[hidden] {
    display: none;
  }

  .block {
    margin-bottom: 1rem;
  }

  .block:last-child {
    margin-bottom: 0;
  }

  h4 {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    color: var(--color-accent-blue);
    margin: 0 0 0.5rem;
  }

  p {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    line-height: 1.6;
    margin: 0;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.375rem;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }

  li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--color-accent-green);
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .timeline-entry {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.85rem;
  }

  .timeline-date {
    font-family: var(--font-mono);
    color: var(--color-accent-green);
    white-space: nowrap;
  }

  .timeline-milestone {
    color: var(--color-text-secondary);
  }
</style>

<script>
  function initCaseStudyToggles() {
    document.querySelectorAll('.case-study .toggle').forEach((btn) => {
      const button = btn as HTMLButtonElement;
      if (button.dataset.initialized) return;
      button.dataset.initialized = 'true';

      const content = button.nextElementSibling as HTMLElement;
      if (!content) return;

      button.addEventListener('click', () => {
        const expanded = button.getAttribute('aria-expanded') === 'true';
        const next = !expanded;
        button.setAttribute('aria-expanded', String(next));
        content.hidden = !next;
        button.querySelector('.toggle-icon')!.textContent = next ? '−' : '+';
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initCaseStudyToggles);
  document.addEventListener('astro:page-load', initCaseStudyToggles);
</script>
