---
import { getDict } from '../i18n/ui';

interface Props {
  title: string;
  num?: string;
  xp?: number;
  tag?: string;
}

const { title, num, xp, tag } = Astro.props;
const t = getDict(Astro.currentLocale);
---

<div class="terminal-header">
  <div class="terminal-buttons" aria-hidden="true">
    <span class="dot dot--red"></span>
    <span class="dot dot--amber"></span>
    <span class="dot dot--green"></span>
  </div>

  <h2>
    {num && <span class="terminal-num">{num}</span>}
    <span class="terminal-title">{title}</span>
    {tag && <span class="terminal-tag">{tag}</span>}
  </h2>

  <div class="terminal-meta">
    {xp && <span class="terminal-xp">+{xp} XP</span>}
    <button
      class="minimize-btn"
      type="button"
      aria-expanded="true"
      aria-label={`${t.projects.collapse} ${title}`}
      data-label-collapse={t.projects.collapse}
      data-label-expand={t.projects.expand}
    >
      <span class="minimize-icon" aria-hidden="true">▾</span>
    </button>
  </div>
</div>

<script>
  function setMinimized(section: Element, minimized: boolean): void {
    const button = section.querySelector<HTMLButtonElement>('.minimize-btn');
    section.classList.toggle('minimized', minimized);
    button?.setAttribute('aria-expanded', String(!minimized));
    const label = minimized ? button?.dataset.labelExpand : button?.dataset.labelCollapse;
    if (label) button?.setAttribute('aria-label', `${label} ${section.id}`);
    if (!minimized) {
      section.style.animation = 'none';
      void (section as HTMLElement).offsetHeight;
      section.style.animation = '';
    }
    localStorage.setItem(`section-${section.id}-minimized`, String(minimized));
  }

  function initSections(): void {
    document.querySelectorAll<HTMLElement>('section[id]').forEach((section) => {
      // Content is visible by default; only an explicit user choice collapses it.
      const stored = localStorage.getItem(`section-${section.id}-minimized`) === 'true';
      setMinimized(section, stored);
    });

    document.querySelectorAll<HTMLButtonElement>('.minimize-btn').forEach((button) => {
      button.addEventListener('click', () => {
        const section = button.closest('section');
        if (!section) return;
        setMinimized(section, !section.classList.contains('minimized'));
      });
    });

    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
      a.addEventListener('click', () => {
        const target = document.querySelector(a.getAttribute('href') ?? '');
        const section = target?.closest('section');
        if (section) setMinimized(section, false);
      });
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initSections);
  else initSections();
</script>

<style>
  .terminal-header {
    background: linear-gradient(180deg, rgba(15, 22, 30, 0.92), rgba(9, 14, 20, 0.92));
    padding: 0.6rem 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    border-bottom: 1px solid rgba(0, 240, 255, 0.22);
    position: relative;
    z-index: 3;
  }

  .terminal-header::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 90px;
    height: 1px;
    background: linear-gradient(90deg, #00ff41, transparent);
    box-shadow: 0 0 10px rgba(0, 255, 65, 0.6);
  }

  .terminal-buttons {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    display: block;
    transition: all 0.2s ease;
  }

  .dot--red { background: #3a1620; box-shadow: inset 0 0 0 1px rgba(255, 0, 65, 0.5); }
  .dot--amber { background: #3a2c14; box-shadow: inset 0 0 0 1px rgba(255, 176, 32, 0.5); }
  .dot--green { background: #00ff41; box-shadow: 0 0 8px rgba(0, 255, 65, 0.8); }

  h2 {
    flex: 1;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    color: #eafcff;
    min-width: 0;
  }

  .terminal-num {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    color: rgba(0, 240, 255, 0.5);
  }

  .terminal-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .terminal-tag {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.14em;
    color: rgba(255, 43, 214, 0.75);
    border: 1px solid rgba(255, 43, 214, 0.3);
    padding: 0.12rem 0.35rem;
    white-space: nowrap;
  }

  .terminal-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .terminal-xp {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    color: rgba(0, 255, 65, 0.7);
  }

  .minimize-btn {
    background: rgba(0, 240, 255, 0.04);
    border: 1px solid rgba(0, 240, 255, 0.2);
    color: #9fdcf0;
    width: 1.7rem;
    height: 1.7rem;
    cursor: pointer;
    display: grid;
    place-items: center;
    border-radius: 2px;
    transition: all 0.16s ease;
    padding: 0;
  }

  .minimize-btn:hover {
    border-color: #00f0ff;
    color: #fff;
    box-shadow: 0 0 14px rgba(0, 240, 255, 0.25);
  }

  .minimize-icon {
    font-size: 0.7rem;
    line-height: 1;
    transition: transform 0.25s ease;
  }

  section.minimized .minimize-icon {
    transform: rotate(-90deg);
  }

  @media (max-width: 600px) {
    .terminal-header {
      padding: 0.55rem 0.65rem;
      gap: 0.55rem;
    }

    h2 {
      font-size: 0.62rem;
    }

    .terminal-tag {
      display: none;
    }

    .terminal-xp {
      display: none;
    }
  }
</style>
