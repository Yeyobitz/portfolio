---
interface Props {
  email: string;
  profiles: Array<{
    network: string;
    url: string;
  }>;
}

const { email, profiles } = Astro.props;

const linkedin = profiles.find((p) => p.network.toLowerCase() === 'linkedin');
const github = profiles.find((p) => p.network.toLowerCase() === 'github');
---

<section id="contact">
  <div class="container">
    <h2 class="section-title">Contacto</h2>
    <p class="section-subtitle">¿Tienes un proyecto en mente? Hablemos.</p>

    <div class="btn-grid">
      <a href={`mailto:${email}`} class="btn btn-email">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2"/>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
        Email
      </a>

      {linkedin && (
        <a href={linkedin.url} target="_blank" rel="noopener noreferrer" class="btn btn-linkedin">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zM9 17H6.477V10H9v7zM7.694 8.717c-.771 0-1.286-.514-1.286-1.2s.514-1.2 1.371-1.2c.771 0 1.286.514 1.286 1.2s-.514 1.2-1.371 1.2zM18 17h-2.442v-3.826c0-1.058-.651-1.302-.895-1.302s-1.058.163-1.058 1.302V17h-2.523v-7h2.523v.977c.325-.57.976-.977 2.209-.977S18 9.977 18 13.174V17z"/>
          </svg>
          LinkedIn
        </a>
      )}

      {github && (
        <a href={github.url} target="_blank" rel="noopener noreferrer" class="btn btn-github">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
          </svg>
          GitHub
        </a>
      )}

      <a href="https://wa.me/56950944500" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm.029 18.88c-1.161 0-2.305-.292-3.318-.844l-3.677.964.984-3.595c-.607-1.052-.927-2.246-.926-3.468.001-3.825 3.113-6.937 6.937-6.937 1.856.001 3.598.723 4.907 2.034 1.31 1.311 2.031 3.054 2.03 4.908-.001 3.825-3.113 6.938-6.937 6.938z"/>
        </svg>
        WhatsApp
      </a>

      <a href="/cv.pdf" class="btn btn-cv">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="16" y1="13" x2="8" y2="13"/>
          <line x1="16" y1="17" x2="8" y2="17"/>
          <polyline points="10 9 9 9 8 9"/>
        </svg>
        Descargar CV
      </a>
    </div>
  </div>
</section>

<style>
  #contact {
    padding: var(--space-2xl) 0;
  }

  .container {
    max-width: var(--container-width);
    margin: 0 auto;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    color: var(--color-text-primary);
    border-left: 4px solid var(--color-accent-green);
    padding-left: 1rem;
    margin-bottom: 0.75rem;
  }

  .section-subtitle {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    margin-bottom: 2rem;
    padding-left: calc(1rem + 4px);
  }

  .btn-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .btn {
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    background: transparent;
    border: 2px solid var(--color-text-muted);
    color: var(--color-text-primary);
    transition: all 0.2s;
    cursor: pointer;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn-email {
    border-color: var(--color-accent-green);
    color: var(--color-accent-green);
  }

  .btn-email:hover {
    background: rgba(46, 160, 67, 0.1);
  }

  .btn-linkedin {
    border-color: var(--color-accent-blue);
    color: var(--color-accent-blue);
  }

  .btn-linkedin:hover {
    background: rgba(88, 166, 255, 0.1);
  }

  .btn-github {
    border-color: var(--color-text-muted);
    color: var(--color-text-primary);
  }

  .btn-github:hover {
    background: rgba(110, 118, 129, 0.1);
  }

  .btn-whatsapp {
    border-color: var(--color-accent-green);
    color: var(--color-accent-green);
  }

  .btn-whatsapp:hover {
    background: rgba(46, 160, 67, 0.1);
  }

  .btn-cv {
    background: var(--color-accent-green);
    border-color: var(--color-accent-green);
    color: #fff;
  }

  .btn-cv:hover {
    background: #2c9740;
    border-color: #2c9740;
  }

  @media (max-width: 768px) {
    #contact {
      padding: var(--space-xl) 0;
    }

    .section-title {
      font-size: 1.5rem;
    }

    .btn {
      padding: 0.65rem 1.25rem;
      font-size: 0.8rem;
    }
  }
</style>
