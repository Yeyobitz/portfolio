---
const navLinks = [
  { href: '#about', num: '01', label: 'ABOUT', glitch: 'ABOUT' },
  { href: '#projects', num: '02', label: 'QUESTS', glitch: 'QUESTS' },
  { href: '#skills', num: '03', label: 'SKILLS', glitch: 'SKILLS' },
  { href: '#contact', num: '04', label: 'CONTACT', glitch: 'CONTACT' },
];
---

<header>
  <nav aria-label="Main navigation" class="site-nav">
    <div class="nav-content">
      <a href="#top" class="logo" aria-label="Back to top">
        <span class="logo__mark" aria-hidden="true">▚</span>
        <span class="logo__text">YEYOBITZ</span>
      </a>

      <div class="nav-links">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="nav-link"
            data-quest={link.href.slice(1)}
            data-glitch={link.glitch}
          >
            <span class="nav-num" aria-hidden="true">{link.num}</span>
            <span class="nav-label">{link.label}</span>
            <span class="nav-check" aria-hidden="true">✓</span>
          </a>
        ))}
      </div>

      <div class="nav-status" aria-hidden="true">
        <span class="nav-status__dot"></span>
        <span class="nav-status__txt">ONLINE</span>
      </div>

      <button class="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span class="menu-line"></span>
        <span class="menu-line"></span>
        <span class="menu-line"></span>
      </button>
    </div>

    <div id="mobile-menu" class="mobile-menu" aria-hidden="true">
      <div class="mobile-menu-content">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link"
            data-quest={link.href.slice(1)}
          >
            <span class="nav-num" aria-hidden="true">{link.num}</span>
            {link.label}
            <span class="nav-check" aria-hidden="true">✓</span>
          </a>
        ))}
        <p class="mobile-menu-hint">↑↑↓↓←→←→BA</p>
      </div>
    </div>
  </nav>
</header>

<style>
  .site-nav {
    background: rgba(4, 7, 12, 0.72);
    backdrop-filter: blur(14px) saturate(120%);
    border-bottom: 1px solid rgba(0, 240, 255, 0.18);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .site-nav.is-scrolled {
    background: rgba(3, 5, 10, 0.92);
    border-bottom-color: rgba(0, 240, 255, 0.3);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
  }

  .nav-content {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: clamp(0.6rem, 2vw, 2rem);
    width: var(--container-width);
    max-width: 1240px;
    margin: 0 auto;
    padding: 0.55rem var(--container-padding);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: #dffaff;
    text-decoration: none;
    white-space: nowrap;
  }

  .logo__mark {
    color: #00ff41;
    text-shadow: 0 0 12px rgba(0, 255, 65, 0.8);
    animation: logoBlink 4s steps(1) infinite;
  }

  .logo:hover .logo__mark {
    color: #00f0ff;
    text-shadow: 0 0 14px rgba(0, 240, 255, 0.9);
  }

  .nav-links {
    display: flex;
    gap: 0.15rem;
    justify-content: center;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    color: rgba(205, 228, 240, 0.82);
    text-decoration: none;
    border: 1px solid transparent;
    border-radius: 2px;
    position: relative;
    transition: all 0.16s ease;
    white-space: nowrap;
  }

  .nav-num {
    font-size: 0.5rem;
    color: rgba(0, 240, 255, 0.45);
    letter-spacing: 0.06em;
    transition: color 0.16s ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: #fff;
    border-color: rgba(0, 240, 255, 0.35);
    background: rgba(0, 240, 255, 0.06);
    text-shadow: 0 0 12px rgba(0, 240, 255, 0.55);
  }

  .nav-link:hover .nav-num {
    color: #00ff41;
  }

  .nav-check {
    display: none;
    color: #00ff41;
    font-size: 0.6rem;
  }

  .nav-link.is-done .nav-check,
  .mobile-nav-link.is-done .nav-check {
    display: inline;
  }

  .nav-link.is-done .nav-label {
    color: rgba(0, 255, 65, 0.75);
  }

  .nav-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.18em;
    color: rgba(0, 255, 65, 0.7);
    padding-left: 0.6rem;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
  }

  .nav-status__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #00ff41;
    box-shadow: 0 0 10px #00ff41;
    animation: statusPulse 2.6s ease-in-out infinite;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.4rem;
  }

  .menu-line {
    display: block;
    width: 22px;
    height: 2px;
    margin: 5px 0;
    background-color: #00ff41;
    box-shadow: 0 0 6px rgba(0, 255, 65, 0.7);
    transition: all 0.25s ease;
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    background: rgba(2, 4, 8, 0.97);
    backdrop-filter: blur(16px);
    z-index: 95;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .mobile-menu.active {
    opacity: 1;
    visibility: visible;
  }

  .mobile-menu-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 1.4rem;
    padding: 2rem;
  }

  .mobile-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: #dffaff;
    text-decoration: none;
    font-family: var(--font-heading);
    font-size: 1.1rem;
    padding: 0.7rem 1.2rem;
    border: 1px solid rgba(0, 240, 255, 0.2);
    transition: all 0.2s ease;
  }

  .mobile-nav-link:hover {
    color: #00ff41;
    border-color: #00ff41;
    box-shadow: 0 0 24px rgba(0, 255, 65, 0.2);
  }

  .mobile-menu-hint {
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.3em;
    color: rgba(255, 43, 214, 0.5);
  }

  @keyframes logoBlink {
    0%, 96%, 100% { opacity: 1; }
    97%, 99% { opacity: 0.2; }
  }

  @keyframes statusPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  @media (max-width: 900px) {
    .nav-status {
      display: none;
    }

    .nav-content {
      grid-template-columns: auto 1fr auto;
    }
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }

    .nav-content {
      grid-template-columns: 1fr auto;
    }

    .menu-toggle {
      display: block;
    }

    .menu-toggle.active .menu-line:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
    }

    .menu-toggle.active .menu-line:nth-child(2) {
      opacity: 0;
    }

    .menu-toggle.active .menu-line:nth-child(3) {
      transform: rotate(-45deg) translate(6px, -5px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo__mark,
    .nav-status__dot {
      animation: none !important;
    }
  }
</style>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const mobileMenu = document.querySelector<HTMLElement>('.mobile-menu');
  const mobileLinks = Array.from(document.querySelectorAll<HTMLElement>('.mobile-nav-link'));
  const nav = document.querySelector<HTMLElement>('.site-nav');

  function toggleMenu(): void {
    const isExpanded = menuToggle?.getAttribute('aria-expanded') === 'true';
    menuToggle?.setAttribute('aria-expanded', String(!isExpanded));
    menuToggle?.setAttribute('aria-label', isExpanded ? 'Open menu' : 'Close menu');
    mobileMenu?.setAttribute('aria-hidden', String(isExpanded));
    menuToggle?.classList.toggle('active', !isExpanded);
    mobileMenu?.classList.toggle('active', !isExpanded);
    document.body.style.overflow = isExpanded ? '' : 'hidden';
    if (!isExpanded && mobileLinks[0]) mobileLinks[0].focus();
  }

  menuToggle?.addEventListener('click', toggleMenu);

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      toggleMenu();
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu?.classList.contains('active')) toggleMenu();
  });

  function onScroll(): void {
    nav?.classList.toggle('is-scrolled', window.scrollY > 24);
  }
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
