---
import { getDict, normalizeLang } from '../../i18n/ui';

interface Props {
  name: string;
  headline: string;
  label: string;
  summary: string;
  email: string;
}

const { name, headline, label, summary, email } = Astro.props;
const t = getDict(Astro.currentLocale);
const lang = normalizeLang(Astro.currentLocale);
const [first, ...rest] = name.split(' ');
const last = rest.join(' ');
const cvHref = lang === 'en' ? '/en/cv' : '/cv';
---

<section class="hero" id="top">
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__inner">
    <div class="hero__copy">
      <p class="hero__kicker">
        <span class="hero__dot" aria-hidden="true"></span>
        {t.hero.kicker.map((part, i) => (
          <span class="hero__kicker-part">
            {i > 0 && <i class="hero__sep" aria-hidden="true">·</i>}
            {part}
          </span>
        ))}
      </p>

      <p class="hero__role">{headline}</p>

      <h1 class="hero__title">
        <span class="hero__line">{first}</span>
        <span class="hero__line hero__line--accent">{last}<span class="hero__caret" aria-hidden="true">_</span></span>
      </h1>

      <p class="hero__blurb">{summary}</p>

      <div class="hero__cta">
        <a class="btn-hero btn-hero--primary" href={cvHref}>
          <span aria-hidden="true">↓</span> {t.hero.start}
        </a>
        <a class="btn-hero" href="#experience">
          <span aria-hidden="true">◇</span> {t.hero.questlog}
        </a>
      </div>

      <p class="hero__mail">
        <span>{t.hero.emailLabel}:</span>
        <a href={`mailto:${email}`}>{email}</a>
      </p>

      <ul class="hero__stats">
        <li><b>300+</b><span>{t.hero.stats.users}</span></li>
        <li><b>15+</b><span>{t.hero.stats.containers}</span></li>
        <li><b>C2</b><span>{t.hero.stats.english}</span></li>
        <li><b>03</b><span>{t.hero.stats.projects}</span></li>
      </ul>
    </div>

    <div class="hero__hints">
      <span class="hero__hint">{t.hero.hint}</span>
      <a class="hero__scroll" href="#experience">
        <span>{t.hero.scroll}</span>
        <i aria-hidden="true">↓</i>
      </a>
      <span class="hero__loc">{t.hero.loc}</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(100svh, 860px);
    display: flex;
    align-items: center;
    padding: clamp(6rem, 12vh, 8rem) 0 5.5rem;
    overflow: hidden;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, #03050a 0%, rgba(3, 5, 9, 0.96) 30%, rgba(3, 5, 9, 0.7) 46%, rgba(3, 5, 9, 0) 66%),
      radial-gradient(ellipse 55% 55% at 20% 42%, rgba(3, 5, 9, 0.55), transparent 72%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    width: var(--container-width);
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--container-padding);
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .hero__copy {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .hero__kicker {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.34em;
    color: rgba(0, 240, 255, 0.82);
    text-transform: uppercase;
  }

  .hero__kicker-part {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    white-space: nowrap;
  }

  .hero__sep {
    font-style: normal;
    color: rgba(150, 180, 200, 0.4);
  }

  .hero__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #00ff41;
    box-shadow: 0 0 12px #00ff41;
    animation: heroPulse 2.4s ease-in-out infinite;
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 4.8vw, 3.5rem);
    line-height: 1.12;
    letter-spacing: 0.03em;
    color: #f2fbff;
    text-shadow:
      0 0 3px rgba(255, 255, 255, 0.5),
      0 0 26px rgba(0, 240, 255, 0.35),
      0 0 70px rgba(0, 240, 255, 0.18);
  }

  .hero__caret {
    color: #00ff41;
    animation: heroBlink 1.05s steps(1) infinite;
  }

  .hero__role {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(0.88rem, 1.8vw, 1.1rem);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #ff8ce6;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }

  .hero__line {
    display: block;
  }

  .hero__line--accent {
    color: #00f0ff;
    text-shadow:
      0 0 3px rgba(255, 255, 255, 0.35),
      0 0 30px rgba(0, 240, 255, 0.4);
  }

  .hero__role::before {
    content: '';
    width: 2.4rem;
    height: 1px;
    background: linear-gradient(90deg, #ff2bd6, transparent);
  }

  .hero__blurb {
    margin: 0.4rem 0 0;
    max-width: 52ch;
    font-size: clamp(0.98rem, 1.7vw, 1.12rem);
    line-height: 1.7;
    color: #e4eff7;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  .hero__stats {
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0.9rem 0 0;
    border-top: 1px dashed rgba(0, 240, 255, 0.2);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.8rem;
  }

  .hero__stats li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .hero__stats b {
    font-family: var(--font-heading);
    font-size: 1rem;
    color: #00ff41;
    text-shadow: 0 0 14px rgba(0, 255, 65, 0.45);
  }

  .hero__stats span {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    color: rgba(175, 200, 215, 0.8);
  }

  .hero__hints {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    color: rgba(150, 180, 200, 0.55);
  }

  .hero__hint {
    color: rgba(255, 43, 214, 0.65);
  }

  @media (max-width: 1180px) {
    .hero__hint {
      display: none;
    }
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(0, 240, 255, 0.8);
    text-decoration: none;
    letter-spacing: 0.18em;
    border-bottom: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .hero__scroll:hover {
    color: #fff;
    border-bottom-color: rgba(0, 240, 255, 0.5);
  }

  .hero__scroll i {
    font-style: normal;
    animation: heroBounce 2s ease-in-out infinite;
  }

  .hero__loc {
    color: rgba(160, 185, 205, 0.6);
  }

  .hero__mail {
    margin: 0.2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: rgba(160, 185, 205, 0.7);
  }

  .hero__mail a {
    color: #bff3ff;
    text-decoration: none;
    border-bottom: 1px solid rgba(0, 240, 255, 0.3);
  }

  .hero__mail a:hover {
    color: #fff;
    border-bottom-color: #00f0ff;
  }

  .hero__copy > * {
    animation: heroRise 0.8s both cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero__copy > :nth-child(2) { animation-delay: 0.08s; }
  .hero__copy > :nth-child(3) { animation-delay: 0.16s; }
  .hero__copy > :nth-child(4) { animation-delay: 0.24s; }
  .hero__copy > :nth-child(5) { animation-delay: 0.32s; }
  .hero__copy > :nth-child(6) { animation-delay: 0.4s; }

  @keyframes heroRise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes heroBlink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  @keyframes heroPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  @keyframes heroBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  @media (max-width: 380px) {
    .hero__cta {
      flex-direction: column;
      align-items: stretch;
    }

    .btn-hero {
      justify-content: center;
    }
  }

  @media (max-width: 900px) {
    .hero {
      align-items: flex-start;
      padding-top: 6.5rem;
    }

    .hero__scrim {
      background:
        linear-gradient(180deg, rgba(3, 5, 9, 0.92) 0%, rgba(3, 5, 9, 0.72) 45%, rgba(3, 5, 9, 0.25) 100%);
    }

    .hero__title {
      font-size: clamp(1.5rem, 8vw, 2.6rem);
    }

    .hero__hints {
      font-size: 0.52rem;
    }

    .hero__kicker {
      font-size: 0.55rem;
      letter-spacing: 0.2em;
    }

    .hero__hint {
      order: 3;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__copy > *,
    .hero__caret,
    .hero__dot,
    .hero__scroll i {
      animation: none !important;
    }
  }
</style>
