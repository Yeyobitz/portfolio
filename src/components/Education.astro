---
interface EducationEntry {
  institution: string;
  degree: string;
  field: string;
  startYear: string;
  endYear: string;
}

interface Certification {
  name: string;
  issuer: string;
  year: string;
}

interface Props {
  education: EducationEntry[];
  certifications: Certification[];
}

const { education, certifications } = Astro.props;
---

<section id="education">
  <div class="container">
    <h2>Formación</h2>

    <div class="subsection">
      <h3>Educación</h3>
      {education.map((entry) => (
        <div class="education-card">
          <div class="education-institution">{entry.institution}</div>
          <div class="education-degree">{entry.degree}</div>
          <div class="education-details">
            {entry.field} · {entry.startYear} – {entry.endYear}
          </div>
        </div>
      ))}
    </div>

    <div class="subsection">
      <h3>Certificaciones</h3>
      <ul class="cert-list">
        {certifications.map((cert) => (
          <li class="cert-item">
            <span class="cert-name">{cert.name}</span>
            <span class="cert-details">{cert.issuer} · {cert.year}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  #education {
    padding: var(--space-2xl) 0;
  }

  .container {
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  h2 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--color-accent-green);
    margin-bottom: 2rem;
    border-left: 3px solid var(--color-accent-green);
    padding-left: 1rem;
  }

  .subsection {
    margin-bottom: 2rem;
  }

  .subsection h3 {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    color: var(--color-text-primary);
    margin-bottom: 1.25rem;
    border-left: 3px solid var(--color-accent-blue);
    padding-left: 1rem;
  }

  .education-card {
    border-left: 3px solid var(--color-border);
    padding-left: 1rem;
    margin-bottom: 1.5rem;
    margin-left: 1rem;
  }

  .education-institution {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-text-primary);
    margin-bottom: 0.25rem;
  }

  .education-degree {
    color: var(--color-accent-blue);
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
  }

  .education-details {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }

  .cert-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .cert-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .cert-item:last-child {
    border-bottom: none;
  }

  .cert-name {
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .cert-details {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }
</style>
