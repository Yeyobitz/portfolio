---
import Layout from '../layouts/Layout.astro';
import Hero from './hero/Hero.astro';
import About from './About.astro';
import ProjectsSection from './projects/ProjectsSection.astro';
import SkillsSection from './skills/SkillsSection.astro';
import ContactSection from './contact/ContactSection.astro';
import cvEs from '../data/cv.es.json';
import cvEn from '../data/cv.json';
import { getDict, normalizeLang } from '../i18n/ui';
import type { CV } from '../types/cv';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const l = normalizeLang(lang);
const t = getDict(l);
const cv = (l === 'en' ? cvEn : cvEs) as unknown as CV;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Diego Quiñones Montecinos',
  alternateName: 'Yeyobitz',
  jobTitle: l === 'es' ? 'Especialista de soporte IT y desarrollador full stack' : 'IT Support Specialist & Full Stack Developer',
  url: 'https://yeyobitz.dev',
  email: cv.basics.email,
  sameAs: ['https://github.com/Yeyobitz', 'https://www.linkedin.com/in/diego-alexander-qm-650010249/'],
  knowsAbout: ['Linux', 'Docker', 'TypeScript', 'Python', 'Three.js', 'Astro', 'Homelab'],
  address: { '@type': 'PostalAddress', addressCountry: 'CL' },
  description: t.meta.description,
};
---

<Layout title={t.meta.title} description={t.meta.description} lang={l} jsonLd={jsonLd}>
  <main id="main-content" data-project-total={cv.projects.length}>
    <Hero
      name={cv.basics.name}
      label={cv.basics.label}
      summary={cv.basics.summary}
      projects={cv.projects.length}
    />

    <div class="shell">
      <About
        summary={cv.basics.summary}
        role={cv.basics.label}
        projects={cv.projects.length}
      />

      <ProjectsSection projects={cv.projects} />

      <SkillsSection skills={cv.skills} />

      <ContactSection email={cv.basics.email} profiles={cv.basics.profiles} />
    </div>
  </main>
</Layout>

<style>
  main {
    position: relative;
    z-index: 4;
    padding-bottom: 7rem;
  }

  .shell {
    width: min(100% - 2rem, 1180px);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  @media (max-width: 600px) {
    .shell {
      width: calc(100% - 1.2rem);
      gap: 1.8rem;
    }

    main {
      padding-bottom: 10rem;
    }
  }
</style>
