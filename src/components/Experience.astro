---
import TerminalHeader from './TerminalHeader.astro';
import { getDict } from '../i18n/ui';
import type { Experience } from '../types/cv';

interface Props {
  experience: Experience[];
}

const { experience } = Astro.props;
const t = getDict(Astro.currentLocale);
---

<section class="experience" id="experience">
  <TerminalHeader title={t.experience.title} num="01" xp={25} tag={t.experience.tag} />

  <div class="terminal-content">
    <p class="exp-intro">{t.experience.intro}</p>

    <ol class="timeline">
      {experience.map((job) => (
        <li class="job">
          <div class="job__head">
            <div class="job__titles">
              <h3>{job.role}</h3>
              <span class="job__company">{job.company}</span>
            </div>
            <span class="job__period">{job.period}</span>
          </div>

          {job.promotion && <p class="job__promo">↑ {job.promotion}</p>}
          <p class="job__mode">{job.mode}</p>
          <p class="job__summary">{job.summary}</p>

          <ul class="job__points">
            {job.highlights.map((point) => <li>{point}</li>)}
          </ul>

          <p class="job__tools">
            <span>{t.experience.tools}</span>
            {job.tools.join(' · ')}
          </p>
        </li>
      ))}
    </ol>

    <div class="principles">
      <h3 class="principles__title">{t.experience.principlesTitle}</h3>
      <div class="principles__grid">
        {t.experience.principles.map((rule, i) => (
          <article class="principle">
            <span class="principle__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h4>{rule.title}</h4>
            <p>{rule.text}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .experience {
    position: relative;
    margin: 0 auto;
    background: linear-gradient(180deg, rgba(7, 12, 18, 0.82), rgba(5, 9, 14, 0.9));
    border: 1px solid rgba(0, 240, 255, 0.2);
    border-radius: 4px;
    backdrop-filter: blur(8px);
    overflow: hidden;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.45);
  }

  .terminal-content {
    padding: clamp(1.1rem, 2.4vw, 2rem);
  }

  .exp-intro {
    margin: 0 0 1.6rem;
    max-width: 62ch;
    font-size: 0.88rem;
    line-height: 1.75;
    color: rgba(190, 212, 225, 0.75);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.4rem;
    border-left: 1px solid rgba(0, 240, 255, 0.2);
    display: grid;
    gap: 2rem;
  }

  .job {
    position: relative;
  }

  .job::before {
    content: '';
    position: absolute;
    left: calc(-1.4rem - 5px);
    top: 0.45rem;
    width: 9px;
    height: 9px;
    background: #00ff41;
    box-shadow: 0 0 12px rgba(0, 255, 65, 0.8);
    transform: rotate(45deg);
  }

  .job__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1rem;
  }

  .job__titles {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
  }

  .job h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(0.72rem, 1.6vw, 0.9rem);
    letter-spacing: 0.04em;
    color: #eafcff;
  }

  .job__company {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: #ff8ce6;
  }

  .job__period {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    color: rgba(0, 240, 255, 0.75);
    white-space: nowrap;
  }

  .job__promo,
  .job__mode {
    margin: 0.35rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(0, 255, 65, 0.7);
  }

  .job__mode {
    color: rgba(175, 200, 215, 0.75);
  }

  .job__summary {
    margin: 0.6rem 0 0;
    font-size: 0.86rem;
    line-height: 1.7;
    color: rgba(215, 232, 242, 0.85);
  }

  .job__points {
    list-style: none;
    margin: 0.7rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .job__points li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.82rem;
    line-height: 1.65;
    color: rgba(190, 212, 225, 0.78);
  }

  .job__points li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: #00f0ff;
  }

  .job__tools {
    margin: 0.8rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    color: rgba(175, 200, 215, 0.78);
  }

  .job__tools span {
    color: rgba(0, 240, 255, 0.6);
    letter-spacing: 0.18em;
    margin-right: 0.5rem;
  }

  .principles {
    margin-top: 2.2rem;
    padding-top: 1.4rem;
    border-top: 1px dashed rgba(0, 240, 255, 0.16);
  }

  .principles__title {
    margin: 0 0 0.9rem;
    font-family: var(--font-heading);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    color: rgba(0, 255, 65, 0.8);
  }

  .principles__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.8rem;
  }

  .principle {
    position: relative;
    padding: 0.9rem 0.95rem;
    background: rgba(255, 255, 255, 0.018);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-left: 2px solid rgba(255, 43, 214, 0.45);
  }

  .principle__num {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    color: rgba(255, 43, 214, 0.6);
  }

  .principle h4 {
    margin: 0.25rem 0 0.4rem;
    font-family: var(--font-heading);
    font-size: 0.52rem;
    letter-spacing: 0.08em;
    line-height: 1.6;
    color: #eafcff;
  }

  .principle p {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.65;
    color: rgba(180, 205, 220, 0.75);
  }

  @media (max-width: 600px) {
    .job__head {
      flex-direction: column;
    }

    .job__points li,
    .job__summary {
      font-size: 0.8rem;
    }
  }
</style>
