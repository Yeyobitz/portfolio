---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/hero/Hero.astro';
import About from '../components/About.astro';
import ProjectsSection from '../components/projects/ProjectsSection.astro';
import SkillsSection from '../components/skills/SkillsSection.astro';
import ContactSection from '../components/contact/ContactSection.astro';
import cv from '../data/cv.json';
---

<Layout title="Yeyobitz — Support Specialist & Full-Stack Dev">
  <main id="main-content" data-project-total={cv.projects.length}>
    <Hero
      name={cv.basics.name}
      label={cv.basics.label}
      summary={cv.basics.summary}
      projects={cv.projects.length}
      locations="CONCEPCIÓN · CHILE · UTC-3"
    />

    <div class="shell">
      <About
        summary={cv.basics.summary}
        role={cv.basics.label}
        projects={cv.projects.length}
        email={cv.basics.email}
      />

      <ProjectsSection projects={cv.projects} />

      <SkillsSection skills={cv.skills} />

      <ContactSection email={cv.basics.email} profiles={cv.basics.profiles} />
    </div>
  </main>
</Layout>

<style>
  main {
    position: relative;
    z-index: 4;
    padding-bottom: 7rem;
  }

  .shell {
    width: min(100% - 2rem, 1180px);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  @media (max-width: 600px) {
    .shell {
      width: calc(100% - 1.2rem);
      gap: 1.8rem;
    }

    main {
      padding-bottom: 10rem;
    }
  }
</style>
